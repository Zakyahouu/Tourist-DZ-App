{
  "expo": {
    "name": "ZibanGo",
    "slug": "zibango",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.jpeg",
    "scheme": "zibango",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F4",
        "foregroundImage": "./assets/images/Logo.jpeg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.boucettazakaria.zibango"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "ZibanGo needs access to your photos to upload gallery images."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_with_words.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F4"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirsts": ["**/libworklets.so"]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e3e1640-26c3-422e-8c26-ae2d5256583a"
      }
    }
  }
}
